{
  "git": {
    "tagName": "v${version}",
    "commitMessage": "chore: release v${version}",
    "pushRepo": "https://github.com/tanishqmanuja/ha.integration.rf4ch"
  },
  "github": {
    "release": true,
    "releaseName": "Rf4Ch v${version}",
    "tokenRef": "GITHUB_TOKEN"
  },
  "npm": false,
  "plugins": {
    "@release-it/bumper": {
      "in": "package.json",
      "out": [
        {
          "file": "package.json",
          "path": "version"
        },
        {
          "file": "pyproject.toml",
          "path": "project.version"
        },
        {
          "file": "custom_components/rf4ch/manifest.json",
          "path": "version"
        }
      ]
    },
    "@release-it/conventional-changelog": {
      "preset": {
        "name": "conventionalcommits",
        "types": [
          {
            "type": "feat",
            "section": "🎉 Features"
          },
          {
            "type": "refactor",
            "section": "🏗️ Refactors"
          },
          {
            "type": "fix",
            "section": "🐛 Bug Fixes"
          }
        ]
      },
      "ignoreRecommendedBump": true
    }
  }
}
